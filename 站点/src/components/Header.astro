---
import { scanDocs, groupByDomain, getDomainMeta } from '../lib/docs.js';

const docs = scanDocs();
const domains = groupByDomain(docs);
const domainList = Object.entries(domains)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([slug, data]) => ({
    slug,
    ...getDomainMeta(slug),
    count: data.count,
  }));
---

<header class="sticky top-0 z-50 bg-kudig-dark/80 backdrop-blur-xl border-b border-kudig-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/kudig-database/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-white font-bold text-sm group-hover:bg-primary-500 transition-colors">
          K
        </div>
        <div class="flex flex-col">
          <span class="text-kudig-text font-bold text-sm leading-tight">KUDIG</span>
          <span class="text-kudig-muted text-xs leading-tight">Database</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <a href="/kudig-database/" class="nav-link">首页</a>
        <div class="relative group">
          <button class="nav-link flex items-center gap-1">
            知识域
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-1 w-80 bg-kudig-card border border-kudig-border rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-2">
            <div class="grid grid-cols-1 gap-1 max-h-96 overflow-y-auto">
              {domainList.map(d => (
                <a href={`/kudig-database/${d.slug}/`} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-kudig-dark transition-colors">
                  <span class="text-lg">{d.icon}</span>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm text-kudig-text truncate">{d.name}</div>
                    <div class="text-xs text-kudig-muted">{d.count} 篇文档</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
        <a href="/kudig-database/MOC/" class="nav-link">导航地图</a>
      </nav>

      <!-- Search & Mobile Menu -->
      <div class="flex items-center gap-3">
        <a 
          href="https://github.com/kudig-io/kudig-database" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-kudig-muted hover:text-kudig-text hover:bg-kudig-card transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        
        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-kudig-muted hover:text-kudig-text hover:bg-kudig-card transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-kudig-border">
    <div class="px-4 py-3 space-y-1 max-h-96 overflow-y-auto">
      <a href="/kudig-database/" class="nav-link block">首页</a>
      <div class="px-3 py-2 text-xs font-semibold text-kudig-muted uppercase tracking-wider">知识域</div>
      {domainList.map(d => (
        <a href={`/kudig-database/${d.slug}/`} class="nav-link flex items-center gap-2">
          <span>{d.icon}</span>
          <span>{d.name}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
</script>
