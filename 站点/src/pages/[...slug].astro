---
import DocLayout from '../layouts/DocLayout.astro';
import { scanDocs, renderMarkdown, transformWikilinks } from '../lib/docs.js';

export async function getStaticPaths() {
  const docs = scanDocs();
  
  return docs.map(doc => ({
    params: { slug: doc.slug },
    props: { 
      doc,
      docs,
    },
  }));
}

const { doc, docs } = Astro.props;
const { slug } = Astro.params;

// Get domain from slug
const domain = slug.split('/')[0];

// Transform content
const transformedContent = transformWikilinks(doc.content);

// Render markdown to HTML
const html = await renderMarkdown(transformedContent);

// Extract description from content
const description = doc.frontmatter.description || 
  doc.content.replace(/#.*\n/, '').trim().slice(0, 160).replace(/\n/g, ' ');
---

<DocLayout
  title={doc.title}
  description={description}
  docs={docs}
  currentSlug={slug}
  domain={domain}
  html={html}
/>
