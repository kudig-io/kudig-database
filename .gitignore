# Astro 构建产物（Astro outDir 配置为 ../site）
site/

# Web 服务运行时文件
.web-server.pid
.web-server.log

# 根目录跳转页（由本地脚本自动生成）
index.html

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ruff_cache/
.venv/

# 视频生成产物
video-output/

# RAG 向量化 Pipeline 本地缓存（由 scripts/embedding-pipeline.py 生成，含 >100MB 大文件）
corpus-config/profiles/.vector-cache/

# Node.js（web/ Astro 项目）
web/node_modules/
web/.astro/
web/dist/

# 密钥与环境变量（禁止入库）
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 个人开发环境产物（非便携，勿追踪）
.claude/skills/
.claude/scripts/output/

# 各类 Agent / IDE 辅助工具目录（非语料、非项目源码）
