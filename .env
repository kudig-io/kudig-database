# =============================================================================
# Obsidian Wiki — Environment Configuration
# Project: KUDIG-DATABASE (Kubernetes Production Operations Knowledge Base)
# Language: Chinese (zh) — all wiki output must be in Chinese
# =============================================================================

# --- Required ---

# Absolute path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/Users/allengaller/Documents/GitHub/kudig-io/kudig-database

# --- Optional ---

# Comma-separated source directories to ingest documents from
OBSIDIAN_SOURCES_DIR=

# Wiki categories (adapted to KUDIG structure)
OBSIDIAN_CATEGORIES=concepts,entities,skills,references,synthesis,journal,projects

# Max pages to create/update per ingest operation
OBSIDIAN_MAX_PAGES_PER_INGEST=15

# Claude conversation history path (auto-discovered from ~/.claude if empty)
CLAUDE_HISTORY_PATH=

# Codex history path (defaults to ~/.codex if empty)
CODEX_HISTORY_PATH=

# Pi agent session history path (defaults to ~/.pi/agent/sessions if empty)
PI_HISTORY_PATH=

# Lint schedule: daily | weekly | manual
LINT_SCHEDULE=weekly

# Internal link format: wikilink | markdown
OBSIDIAN_LINK_FORMAT=wikilink

# --- Token Budget ---
WIKI_TOKEN_WARN_THRESHOLD=100000

# --- Staged Writes ---
# Set to true for team wikis where human review is needed
WIKI_STAGED_WRITES=false

# --- Raw Directory ---
OBSIDIAN_RAW_DIR=_raw

# --- QMD Semantic Search (optional) ---
QMD_WIKI_COLLECTION=
QMD_PAPERS_COLLECTION=
QMD_TRANSPORT=mcp
QMD_CLI_SEARCH_MODE=quality
QMD_CLI=qmd

# --- Language ---
# Output language for all wiki operations: en, zh, ja, ko, es, fr, de, etc.
WIKI_OUTPUT_LANGUAGE=zh
