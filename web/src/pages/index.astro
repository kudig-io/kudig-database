---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { scanDocs, groupByDomain, getDomainMeta } from '../lib/docs.js';

const docs = scanDocs();
const domains = groupByDomain(docs);

const domainList = Object.entries(domains)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([slug, data]) => ({
    slug,
    ...getDomainMeta(slug),
    count: data.count,
  }));

const totalDocs = docs.length;
const totalDomains = domainList.length;
---

<BaseLayout title="KUDIG Database - Kubernetes 生产运维全域知识库" description="面向生产环境的 Kubernetes + AI Infrastructure 运维全域知识库，覆盖 20 个核心知识域">
  <Header />
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-900/20 via-kudig-dark to-kudig-dark"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400 text-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
          v2.0 — 20 域全新架构
        </div>
        <h1 class="text-4xl lg:text-6xl font-bold text-kudig-text mb-6 leading-tight">
          Kubernetes 生产运维<br />
          <span class="text-primary-400">全域知识库</span>
        </h1>
        <p class="text-lg text-kudig-muted mb-8 leading-relaxed">
          覆盖集群架构、工作负载、网络、存储、安全、可观测性、AI/ML 基础设施等 20 个核心知识域，
          面向生产环境的系统性运维知识体系。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#domains" class="px-6 py-3 bg-primary-600 hover:bg-primary-500 text-white rounded-lg font-medium transition-colors">
            浏览知识域
          </a>
          <a href="/kudig-database/MOC/" class="px-6 py-3 bg-kudig-card hover:bg-kudig-border text-kudig-text rounded-lg font-medium transition-colors border border-kudig-border">
            导航地图
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-kudig-border bg-kudig-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-400">{totalDomains}</div>
          <div class="text-sm text-kudig-muted mt-1">知识域</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-400">{totalDocs.toLocaleString()}</div>
          <div class="text-sm text-kudig-muted mt-1">知识文档</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-400">4,600+</div>
          <div class="text-sm text-kudig-muted mt-1">Markdown 页面</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-400">24×7</div>
          <div class="text-sm text-kudig-muted mt-1">持续更新</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Domains Grid -->
  <section id="domains" class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-kudig-text mb-4">20 个核心知识域</h2>
        <p class="text-kudig-muted max-w-2xl mx-auto">
          从集群基础架构到 AI/ML 基础设施，从故障诊断到生产运维，系统化覆盖 Kubernetes 全栈知识体系。
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {domainList.map(d => (
          <a href={`/kudig-database/${d.slug}/`} class="domain-card group">
            <div class="flex items-start justify-between mb-4">
              <span class="text-4xl">{d.icon}</span>
              <span class="text-xs font-medium text-kudig-muted bg-kudig-dark px-2 py-1 rounded-full">
                {d.count} 篇
              </span>
            </div>
            <h3 class="text-kudig-text font-semibold text-lg mb-2 group-hover:text-primary-400 transition-colors">
              {d.name}
            </h3>
            <p class="text-sm text-kudig-muted line-clamp-2">
              {d.slug}
            </p>
            <div class="mt-4 flex items-center text-sm text-primary-400 group-hover:text-primary-300 transition-colors">
              进入知识域
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 border-t border-kudig-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-kudig-text mb-4">开源共建</h2>
      <p class="text-kudig-muted mb-8">
        KUDIG Database 是一个开源项目，欢迎提交 Issue 和 PR 来完善知识体系。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="https://github.com/kudig-io/kudig-database" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-kudig-card hover:bg-kudig-border border border-kudig-border text-kudig-text rounded-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub 仓库
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-kudig-border py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-kudig-muted">
      <p>© 2024-2026 KUDIG Team. Built with Astro.</p>
    </div>
  </footer>
</BaseLayout>
