---
import { buildNavTree } from '../lib/docs.js';

export interface Props {
  docs: any[];
  currentSlug: string;
  domain: string;
}

const { docs, currentSlug, domain } = Astro.props;
const tree = buildNavTree(docs, domain);

function renderTree(tree, path = '') {
  const entries = Object.entries(tree).sort(([a], [b]) => {
    const aIsDir = tree[a].isDir;
    const bIsDir = tree[b].isDir;
    if (aIsDir && !bIsDir) return -1;
    if (!aIsDir && bIsDir) return 1;
    return a.localeCompare(b);
  });
  
  return entries.map(([key, value]) => {
    const currentPath = path ? `${path}/${key}` : key;
    const fullSlug = `${domain}/${currentPath}`;
    const isActive = currentSlug === fullSlug || currentSlug.startsWith(fullSlug + '/');
    
    if (value.isFile) {
      const displayName = value.title || key.replace(/-/g, ' ');
      return `
        <a href="/kudig-database/${fullSlug}/" class="sidebar-link ${isActive ? 'active' : ''}">
          ${displayName}
        </a>
      `;
    } else {
      const dirName = key.replace(/-/g, ' ').replace(/^topic-/, '');
      return `
        <div class="mb-2">
          <div class="px-2 py-1 text-xs font-semibold text-kudig-muted uppercase tracking-wider">${dirName}</div>
          <div class="pl-2 border-l border-kudig-border/50 space-y-0.5">
            ${renderTree(value.children, currentPath)}
          </div>
        </div>
      `;
    }
  }).join('');
}

const treeHtml = renderTree(tree);
---

<aside class="w-64 shrink-0 hidden lg:block">
  <div class="sticky top-20 h-[calc(100vh-5rem)] overflow-y-auto pr-4">
    <div class="text-sm">
      <div class="mb-4 pb-3 border-b border-kudig-border">
        <a href={`/kudig-database/${domain}/`} class="text-kudig-text font-semibold hover:text-primary-400 transition-colors">
          ← 返回 Domain 首页
        </a>
      </div>
      <Fragment set:html={treeHtml} />
    </div>
  </div>
</aside>

<!-- Mobile Sidebar Toggle -->
<div class="lg:hidden mb-4">
  <button id="sidebar-toggle" class="flex items-center gap-2 px-4 py-2 bg-kudig-card rounded-lg text-kudig-text">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    目录
  </button>
  <div id="mobile-sidebar" class="hidden mt-2 bg-kudig-card border border-kudig-border rounded-lg p-4 max-h-96 overflow-y-auto">
    <Fragment set:html={treeHtml} />
  </div>
</div>

<script>
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  
  sidebarToggle?.addEventListener('click', () => {
    mobileSidebar.classList.toggle('hidden');
  });
</script>
