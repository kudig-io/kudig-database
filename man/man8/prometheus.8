.SH ALERTING RULES EXAMPLE
.RS
.nf
groups:
  - name: kubernetes-resources
    rules:
      - alert: HighMemoryUsage
        expr: |
          (container_memory_usage_bytes /
           container_spec_memory_limit_bytes) > 0.85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage detected"
.fi
.RE
